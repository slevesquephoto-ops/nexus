# Base de données
DB_PASSWORD=CHANGER_CE_MOT_DE_PASSE

# JWT
JWT_SECRET=CHANGER_CE_SECRET_LONG_ET_ALEATOIRE

# Environnement
NODE_ENV=production

# URL de l'API (utilisée par le frontend au build time)
# En dev : http://localhost:4000
# En prod : http://IP_DU_SERVEUR:4000 ou http://nexus.local/api
NEXT_PUBLIC_API_URL=http://localhost:4000

# Origines autorisées pour CORS (séparées par des virgules, sans espaces)
# En dev : http://localhost:3000
# En prod : http://IP_DU_SERVEUR,http://IP_DU_SERVEUR:3000,http://nexus.local
ALLOWED_ORIGINS=http://localhost:3000
