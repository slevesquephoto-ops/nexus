generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(cuid())
  username       String         @unique
  email          String?        @unique
  passwordHash   String
  role           Role           @default(STUDENT)
  xp             Int            @default(0)
  level          Int            @default(1)
  avatarId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  classes        ClasseMember[]
  classesCreated Classe[]       @relation("TeacherClasses")
  enrollments    Enrollment[]
  createdBy      String?
  createdByUser  User?          @relation("CreatedUsers", fields: [createdBy], references: [id])
  usersCreated   User[]         @relation("CreatedUsers")
  taskProgress   TaskProgress[]
  badges         UserBadge[]
  avatarRewards  UserAvatarReward[]
  xpLogs         XpLog[]
}

model Parcours {
  id                String                @id
  title             String
  description       String?
  language          String                @default("fr")
  isPublic          Boolean               @default(false)
  order             Int                   @default(0)
  prerequisiteId    String?
  createdAt         DateTime              @default(now())
  classes           ClasseParcours[]
  trackRestrictions ClasseParcoursTrack[]
  enrollments       Enrollment[]
  tracks            ParcoursTracks[]
  prerequisite      Parcours?             @relation("ParcoursPrerequisite", fields: [prerequisiteId], references: [id])
  dependents        Parcours[]            @relation("ParcoursPrerequisite")
}

model Track {
  id                String                @id
  title             String
  description       String?
  language          String                @default("fr")
  icon              String?
  order             Int                   @default(0)
  createdAt         DateTime              @default(now())
  modules           Module[]
  parcours          ParcoursTracks[]
  classRestrictions ClasseParcoursTrack[]
}

model ParcoursTracks {
  parcoursId String
  trackId    String
  order      Int      @default(0)
  parcours   Parcours @relation(fields: [parcoursId], references: [id])
  track      Track    @relation(fields: [trackId], references: [id])

  @@id([parcoursId, trackId])
}

model Module {
  id          String   @id
  trackId     String
  title       String
  description String?
  order       Int
  xpReward    Int      @default(50)
  mascot      String?
  createdAt   DateTime @default(now())
  track       Track    @relation(fields: [trackId], references: [id])
  tasks       Task[]
}

model Task {
  id        String         @id
  moduleId  String
  type      TaskType
  title     String
  order     Int
  xpReward  Int            @default(15)
  content   Json?
  createdAt DateTime       @default(now())
  module    Module         @relation(fields: [moduleId], references: [id])
  progress  TaskProgress[]
}

model TaskProgress {
  id          String    @id @default(cuid())
  userId      String
  taskId      String
  completed   Boolean   @default(false)
  score       Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  task        Task      @relation(fields: [taskId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, taskId])
}

model Classe {
  id                String                @id @default(cuid())
  name              String
  teacherId         String
  inviteCode        String                @unique @default(cuid())
  createdAt         DateTime              @default(now())
  teacher           User                  @relation("TeacherClasses", fields: [teacherId], references: [id])
  members           ClasseMember[]
  parcours          ClasseParcours[]
  trackRestrictions ClasseParcoursTrack[]
}

model ClasseParcours {
  classeId   String
  parcoursId String
  classe     Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)
  parcours   Parcours @relation(fields: [parcoursId], references: [id])

  @@id([classeId, parcoursId])
}

model ClasseParcoursTrack {
  classeId   String
  parcoursId String
  trackId    String
  classe     Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)
  parcours   Parcours @relation(fields: [parcoursId], references: [id])
  track      Track    @relation(fields: [trackId], references: [id])

  @@id([classeId, parcoursId, trackId])
}

model ClasseMember {
  userId   String
  classeId String
  classe   Classe @relation(fields: [classeId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@id([userId, classeId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  parcoursId String
  enrolledAt DateTime @default(now())
  parcours   Parcours @relation(fields: [parcoursId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, parcoursId])
}

model Badge {
  id          String      @id
  title       String
  description String
  imageUrl    String
  condition   String?
  createdAt   DateTime    @default(now())
  users       UserBadge[]
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@id([userId, badgeId])
}

model AvatarReward {
  id          String             @id
  avatarId    String
  triggerType String
  triggerId   String
  title       String
  description String
  earnedBy    UserAvatarReward[]
}

model UserAvatarReward {
  userId         String
  avatarRewardId String
  earnedAt       DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  reward         AvatarReward @relation(fields: [avatarRewardId], references: [id])

  @@id([userId, avatarRewardId])
}

model XpLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum TaskType {
  TASK
  CHALLENGE
}
